{
	"name": "api",
	"version": "1.0.0",
	"description": "",
	"main": "index.js",
	"engines": {
		"node": ">=20 <23"
	},
	"scripts": {
		"build": "tsc && shx cp src/schema/*.graphql dist/src/schema/",
		"start": "node dist/src/index.js",
		"dev": "nodemon --exec tsx src/index.ts",
		"studio": "pnpm dlx prisma studio",
		"docs:generate": "shx rm -f ../../docs/api/introspection.json ../../docs/api/schema.graphql ../../docs/api/README.md && pnpm exec spectaql docs/spectaql.yml --target-dir ../../docs/api --target-file index.html --one-file"
	},
	"keywords": [],
	"author": "",
	"license": "ISC",
	"type": "module",
	"dependencies": {
		"@apollo/server": "^5.4.0",
		"@as-integrations/express5": "^1.1.2",
		"@aws-sdk/client-s3": "^3.1009.0",
		"@prisma/adapter-pg": "^7.4.2",
		"@prisma/client": "^7.4.2",
		"@sentry/node": "^10.43.0",
		"bcrypt": "^6.0.0",
		"cookie-parser": "^1.4.7",
		"cors": "^2.8.6",
		"dotenv": "^16.4.5",
		"express": "^5.2.1",
		"google-auth-library": "^10.6.1",
		"graphql": "^16.12.0",
		"graphql-upload": "^17.0.0",
		"jsonwebtoken": "^9.0.3",
		"prisma": "^7.4.2",
		"signal-exit": "3.0.7",
		"winston": "^3.19.0"
	},
	"devDependencies": {
		"@types/bcrypt": "^6.0.0",
		"@types/cookie-parser": "^1.4.10",
		"@types/cors": "^2.8.19",
		"@types/express": "^5.0.6",
		"@types/graphql-upload": "^17.0.0",
		"@types/jsonwebtoken": "^9.0.10",
		"@types/node": "^25.0.10",
		"nodemon": "^3.1.11",
		"shx": "^0.4.0",
		"spectaql": "^3.0.9",
		"ts-node": "^10.9.2",
		"tsx": "^4.19.2",
		"typescript": "^5.9.3"
	}
}
