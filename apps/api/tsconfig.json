{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"lib": ["ES2022"],

		"rootDir": ".",
		"outDir": "./dist",
		"noEmit": false,

		"allowImportingTsExtensions": false,
		"verbatimModuleSyntax": false,

		"types": ["node"]
	},
	"include": ["src/**/*", "prisma/**/*", "generated/**/*", "services", "*.ts", "validators/**/*"],
	"exclude": ["node_modules", "dist"]
}
