{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    
    "rootDir": "./src",
    "outDir": "./dist",
    "noEmit": false,
    
    "allowImportingTsExtensions": false,
    "verbatimModuleSyntax": false,
    
    "types": ["node"]
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
