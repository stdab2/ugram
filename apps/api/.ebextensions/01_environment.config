option_settings:
  aws:elasticbeanstalk:application:environment:
    NODE_ENV: production
    PORT: 8080
    # Database URL will be constructed from RDS environment variables
    # Format: postgresql://USERNAME:PASSWORD@HOSTNAME:PORT/DATABASE_NAME
    DATABASE_URL: "postgresql://postgres:postgres@${RDS_HOSTNAME}:${RDS_PORT}/${RDS_DB_NAME}"
