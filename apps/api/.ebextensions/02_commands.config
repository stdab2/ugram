container_commands:
  01_generate_prisma_client:
    command: "cd /var/app/staging && DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ugram node_modules/.bin/prisma generate"
    leader_only: true
  02_run_prisma_migrations:
    command: "cd /var/app/staging && node_modules/.bin/prisma migrate deploy"
    leader_only: true

files:
  "/opt/elasticbeanstalk/hooks/appdeploy/post/99_restart_delayed.sh":
    mode: "000755"
    owner: root
    group: root
    content: |
      #!/bin/bash
      # Ensure uploads directory exists
      mkdir -p /var/app/current/uploads/post
      mkdir -p /var/app/current/uploads/profile
      chmod -R 755 /var/app/current/uploads
