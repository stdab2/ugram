container_commands:
  01_run_prisma_migrations:
    command: "cd /var/app/staging && node_modules/.bin/prisma migrate deploy"
    leader_only: true
    test: '[ -n "$RDS_HOSTNAME" ] || [ -n "$DATABASE_URL" ]'

files:
  "/opt/elasticbeanstalk/hooks/appdeploy/post/99_restart_delayed.sh":
    mode: "000755"
    owner: root
    group: root
    content: |
      #!/bin/bash
      # Optionally ensure local uploads directories exist when explicitly enabled.
      # When using S3-based storage exclusively, leave ENABLE_LOCAL_UPLOADS unset or not "true".
      if [ "$ENABLE_LOCAL_UPLOADS" = "true" ]; then
        mkdir -p /var/app/current/uploads/post
        mkdir -p /var/app/current/uploads/profile
        chmod -R 755 /var/app/current/uploads
      fi
