generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  userName     String   @unique
  email     String   @unique
  phoneNumber     String   @unique
  firstName      String
  lastName      String
  picture String?
  posts       Post[]   @relation("UserPosts")
  mentions    Post[]   @relation("UserMentions")
}

model Post {
  id        Int      @id @default(autoincrement())
  createdAt DateTime
  description     String?
  hashtags   String?
  
  authorId    Int
  author      User     @relation("UserPosts", fields: [authorId], references: [id])

  mentionedUsers User[] @relation("UserMentions")
}
