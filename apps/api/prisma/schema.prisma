generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model UserUgram {
  id            Int      @id @default(autoincrement())
  createdAt     DateTime @default(now())
  userName      String   @unique
  password      String?
  googleSub     String?  @unique
  email         String   @unique
  phoneNumber   String?  @unique
  firstName     String
  lastName      String
  picture       String?
  posts         Post[]   @relation("UserPosts")
  mentions      Post[]   @relation("UserMentions")
  likes          Like[]
}

model Post {
  id             Int       @id @default(autoincrement())
  createdAt      DateTime  @default(now())
  description    String
  imageUrl       String

  authorId       Int
  author         UserUgram  @relation("UserPosts", fields: [authorId], references: [id], onDelete: Cascade)

  mentionedUsers UserUgram[] @relation("UserMentions")

  hashtags       Hashtag[]   @relation("PostHashtags")
  likes          Like[]
}

model Hashtag {
  id    Int    @id @default(autoincrement())
  name  String @unique

  posts Post[] @relation("PostHashtags")
}

model Like {
  userId    Int
  postId    Int
  createdAt DateTime @default(now())

  user      UserUgram @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post      @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([userId, postId])
}
