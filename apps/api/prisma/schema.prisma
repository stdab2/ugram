generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum NotificationType {
  LIKE
  COMMENT
}

model UserUgram {
  id            Int      @id @default(autoincrement())
  createdAt     DateTime @default(now())
  userName      String   @unique
  password      String?
  googleSub     String?  @unique
  email         String   @unique
  phoneNumber   String?  @unique
  firstName     String
  lastName      String
  picture       String?
  posts         Post[]   @relation("UserPosts")
  mentions      Post[]   @relation("UserMentions")
  messages      Message[] @relation("UserMessages")
  likes          Like[]
  following      Follow[] @relation("Following")
  followers      Follow[] @relation("Followers")
  notifications  Notification[] @relation("UserNotificationsReceived")
  notificationsSent Notification[] @relation("UserNotificationsActor")
}

model Follow {
  followerId  Int
  followingId Int
  createdAt   DateTime @default(now())

  follower    UserUgram @relation("Following", fields: [followerId], references: [id], onDelete: Cascade)
  following   UserUgram @relation("Followers", fields: [followingId], references: [id], onDelete: Cascade)

  @@id([followerId, followingId])
  @@index([followingId])
}

model Post {
  id             Int       @id @default(autoincrement())
  createdAt      DateTime  @default(now())
  description    String
  imageUrl       String

  authorId       Int
  author         UserUgram  @relation("UserPosts", fields: [authorId], references: [id], onDelete: Cascade)

  mentionedUsers UserUgram[] @relation("UserMentions")

  hashtags       Hashtag[]   @relation("PostHashtags")
  messages       Message[]   @relation("PostMessages")
  likes          Like[]
  notifications  Notification[] @relation("PostNotifications")
}

model Hashtag {
  id    Int    @id @default(autoincrement())
  name  String @unique

  posts Post[] @relation("PostHashtags")
}

model Message {
  id            Int       @id @default(autoincrement())
  createdAt     DateTime  @default(now())
  content       String

  authorId      Int
  author        UserUgram @relation("UserMessages", fields: [authorId], references: [id], onDelete: Cascade)

  postId        Int
  post          Post      @relation("PostMessages", fields: [postId], references: [id], onDelete: Cascade)

  notifications Notification[]
}


model Like {
  userId    Int
  postId    Int
  createdAt DateTime @default(now())

  user      UserUgram @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post      @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([userId, postId])
}

model Notification {
  id         Int              @id @default(autoincrement())
  createdAt  DateTime         @default(now())
  readAt     DateTime?
  type       NotificationType

  recipientId Int
  recipient   UserUgram       @relation("UserNotificationsReceived", fields: [recipientId], references: [id], onDelete: Cascade)

  actorId    Int
  actor      UserUgram        @relation("UserNotificationsActor", fields: [actorId], references: [id], onDelete: Cascade)

  postId     Int
  post       Post             @relation("PostNotifications", fields: [postId], references: [id], onDelete: Cascade)

  messageId  Int?
  message    Message?         @relation(fields: [messageId], references: [id], onDelete: SetNull)

  @@index([recipientId, readAt, createdAt])
  @@index([postId, createdAt])
}
