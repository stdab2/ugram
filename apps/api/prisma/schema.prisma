generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model UserUgram {
  id            Int      @id @default(autoincrement())
  createdAt     DateTime @default(now())
  userName      String   @unique
  password      String
  email         String   @unique
  phoneNumber   String   @unique
  firstName     String
  lastName      String
  picture       String?
  posts         Post[]   @relation("UserPosts")
  mentions      Post[]   @relation("UserMentions")
}

model Post {
  id            Int      @id @default(autoincrement())
  createdAt     DateTime
  description   String?
  hashtags      String?
  imageLink     String
  
  authorId      Int
  author        UserUgram     @relation("UserPosts", fields: [authorId], references: [id])

  mentionedUsers UserUgram[] @relation("UserMentions")
}

